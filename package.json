{
  "name": "startup-finance-monorepo",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:worker\" \"npm run dev:app\"",
    "dev:app": "cd app && pnpm run dev",
    "dev:worker": "cd worker && pnpm run dev",
    "dev:local": "concurrently \"npm run dev:worker\" \"npm run dev:app:local\"",
    "dev:app:local": "cd app && VITE_USE_LOCAL_WORKER=true pnpm run dev",
    "build": "npm run build:app && pnpm run build:worker",
    "build:app": "cd app && pnpm run build",
    "build:worker": "cd worker && pnpm run deploy",
    "install:all": "npm install && cd app && pnpm install && cd ../worker && pnpm install"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "concurrently": "^9.1.0",
    "wrangler": "^4.27.0"
  }
}
